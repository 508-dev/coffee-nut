# Copy to .env and adjust. Never commit .env.
#
# Ports: leave the *_PORT values commented out to use deterministic
# worktree-hashed ports. Run ./scripts/worktree-ports.sh env to see them.

# --- Runtime ----------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Django -----------------------------------------------------------------
# Generate a real one for any deployed environment:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(64))"
# Must be at least 32 bytes; HS256 signing warns below that (RFC 7518 3.2).
DJANGO_SECRET_KEY=insecure-local-key-do-not-deploy
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SETTINGS_MODULE=coffeenut.settings.local

# --- Host-run service ports -------------------------------------------------
API_HOST=127.0.0.1
# API_PORT=8720
WEB_HOST=127.0.0.1
# WEB_PORT=8730

# Optional worktree orchestrator reservations. Leave unset for path-hashed ports.
# WORKTREE_PORT_BLOCK_START=
# WORKTREE_PORT_BLOCK_SIZE=10
# WORKTREE_PRIMARY_PORT=
# WORKTREE_PRIMARY_PORT_TARGET=WEB_PORT

# --- Compose infrastructure -------------------------------------------------
POSTGRES_HOST_BIND=127.0.0.1
# POSTGRES_HOST_PORT=8740
REDIS_HOST_BIND=127.0.0.1
# REDIS_HOST_PORT=8750

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
DATABASE_URL=postgresql://app:app@127.0.0.1:8740/app
REDIS_URL=redis://127.0.0.1:8750/0

# --- Authentication ---------------------------------------------------------
# Falls back to DJANGO_SECRET_KEY when blank. Set separately in production so
# that rotating one does not invalidate the other.
JWT_SIGNING_KEY=
JWT_ACCESS_LIFETIME_MINUTES=15
JWT_REFRESH_LIFETIME_DAYS=7

# The SPA holds its access token in memory and its refresh token in this
# HttpOnly cookie, so script cannot read it. Native clients ignore the cookie
# and send the refresh token in the request body instead.
JWT_REFRESH_COOKIE_NAME=coffeenut_refresh
JWT_REFRESH_COOKIE_SECURE=false
JWT_REFRESH_COOKIE_SAMESITE=Lax
# JWT_REFRESH_COOKIE_DOMAIN=

# --- Cross-origin -----------------------------------------------------------
# Must list the SPA origin exactly; credentials are sent, so "*" is not valid.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8730

# --- Application ------------------------------------------------------------
# Where the SPA is served. Verification and password-reset emails link here.
PUBLIC_WEB_BASE_URL=http://127.0.0.1:8730

# Where the SPA serves share links, used to build the copyable URL returned by
# POST /api/v1/brews/{id}/share/. Defaults to PUBLIC_WEB_BASE_URL + /s.
PUBLIC_SHARE_BASE_URL=http://127.0.0.1:8730/s

# --- Email ------------------------------------------------------------------
# Local development prints to the console; no provider chosen yet.
DEFAULT_FROM_EMAIL=coffee-nut <noreply@localhost>
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true

# --- Web --------------------------------------------------------------------
# SvelteKit exposes only PUBLIC_-prefixed vars to the browser bundle.
PUBLIC_API_BASE_URL=http://127.0.0.1:8720/api/v1

# --- Observability ----------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=coffee-nut
